# Konfigurasi Database (Lokal / Supabase)
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com # Ganti dengan Host dari Supabase Database Settings
DB_PORT=6543 # Port pooler Supabase (disarankan 6543 untuk transaction mode)
DB_USER=postgres.your-project-ref # Ganti dengan username dari Supabase
DB_PASS=Password_Supabase_Anda # Ganti dengan password database Supabase
DB_NAME=postgres # Default database name di Supabase adalah postgres

# Mode Pengembangan (true/false)
DEV_MODE=false
